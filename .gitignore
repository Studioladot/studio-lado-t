# Dependencies
node_modules/

# Environment variables (raíz y web-app/, cualquier nivel)
.env
.env.local
.env*.local

# Next.js build output (web-app/)
.next/

# Vercel
.vercel/

# macOS
.DS_Store

# Skills tooling: contenido descargado y reproducible vía
# `npx skills add ...` / `npx impeccable install ...` — equivalente a
# node_modules. skills-lock.json (fuente + hash por skill) sí se trackea.
.agents/
.claude/skills/

# Plugin de Claude Code (superpowers) — se había colado como submódulo
# git "fantasma" (gitlink sin .gitmodules, ver commit "Fix: eliminar
# submódulo fantasma de superpowers") y probablemente rompía el clone que
# hace Vercel para el build (build de ~200ms, 404 en el dominio — el
# checkout fallaba antes de llegar a encontrar package.json). Se sacó del
# tracking, pero la carpeta sigue en disco (6 MB) — sin esta regla, un
# `git add -A` futuro la volvería a commitear entera como archivos
# normales en vez de como submódulo.
**/.claude/superpowers/

# Config local de Claude Code (permisos, hooks) — por convención, "local"
# no se versiona. .claude/settings.json (sin ".local") si existiera,
# sí se trackearía.
.claude/settings.local.json
