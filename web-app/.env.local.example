NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta Ads OAuth — mismas credenciales que ya viven en las env vars de
# Vercel para api/meta-*.js (legacy). META_APP_ID no es secreto (viaja al
# cliente en la URL de autorización), pero META_APP_SECRET nunca debe
# imprimirse ni commitearse.
META_APP_ID=
META_APP_SECRET=

# Tienda Nube OAuth — mismas credenciales que api/tiendanube-*.js (legacy).
# El redirect URI se configura una sola vez en el panel de Tienda Nube
# Partners, no viaja por request como en Meta.
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
