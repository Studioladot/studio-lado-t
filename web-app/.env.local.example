NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el webhook de Data Deletion de Meta y su página de estado
# pública (src/lib/supabase/service-role.ts) — bypassea RLS, nunca debe
# viajar al cliente ni imprimirse en logs.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Ads OAuth — mismas credenciales que ya viven en las env vars de
# Vercel para api/meta-*.js (legacy). META_APP_ID no es secreto (viaja al
# cliente en la URL de autorización), pero META_APP_SECRET nunca debe
# imprimirse ni commitearse.
META_APP_ID=
META_APP_SECRET=

# Tienda Nube OAuth — mismas credenciales que api/tiendanube-*.js (legacy).
# El redirect URI se configura una sola vez en el panel de Tienda Nube
# Partners, no viaja por request como en Meta.
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=

# IA Estratégica, Diario de Marca y Desbloqueo Creativo (src/lib/ia/client.ts)
# — deepseek-chat.
DEEPSEEK_API_KEY=

# TikTok Login Kit + Content Posting API (Épica Omnicanal, Fase 2 —
# src/lib/tiktok/oauth.ts). TIKTOK_CLIENT_KEY no es secreto (viaja en la URL
# de autorización, igual que META_APP_ID), pero TIKTOK_CLIENT_SECRET nunca
# debe imprimirse ni commitearse. Requiere una app aprobada en TikTok for
# Developers con acceso a la Content Posting API.
#
# TIKTOK_REDIRECT_URI: a diferencia de Meta, el panel de TikTok no acepta
# un Redirect URI de localhost para esta app — cada valor que se use tiene
# que estar registrado de antemano ahí, tal cual (mismo criterio que
# TIENDANUBE_CLIENT_ID de arriba). Por eso es una env var propia por
# entorno en vez de un valor fijo: en Vercel Preview apuntá a la URL de
# ese Preview + /api/auth/tiktok/callback (registrada como URL de prueba
# en el panel de la Salvadera), en producción a
# https://gotix.com.ar/api/auth/tiktok/callback — siempre debe coincidir
# carácter por carácter con lo que esté registrado para ese entorno.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
